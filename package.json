{
  "name": "z-gl",
  "version": "2.13.0",
  "type": "module",
  "description": "Shadertoy-compatible GLSL shader editor",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test tests/e2e/",
    "test:e2e:ui": "playwright test tests/e2e/ --ui",
    "benchmark": "node scripts/benchmark.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/core src/shader \"src/**/*.test.js\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "gen-installer-assets": "node scripts/gen-installer-assets.js"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/sora": "^5.2.8",
    "@fontsource/space-grotesk": "^5.2.10",
    "@fontsource/space-mono": "^5.2.9",
    "@fontsource/syne": "^5.2.7",
    "@shaderfrog/glsl-parser": "^7.0.1",
    "jszip": "^3.10.1",
    "monaco-editor": "^0.55.1",
    "three": "^0.165.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.0",
    "@tauri-apps/cli": "^2",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.5.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.32.0",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.6.2",
    "typescript": "^5.5.0",
    "vite": "^8.0.10",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.{js,css,html,json,md}": [
      "prettier --write"
    ],
    "src/**/*.js": [
      "eslint --fix"
    ]
  }
}
